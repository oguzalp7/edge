{
  "edge-orchestrator-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"hooks/dispatch.cmd\" pre_tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"hooks/dispatch.cmd\" post_tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"hooks/dispatch.cmd\" pre_invocation",
        "timeout": 30
      }
    ]
  }
}
