{
  "edge-orchestrator-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "wsl --cd /home/oguz python3 /home/oguz/.gemini/config/plugins/edge/tools/brigade/orchestrator_guard.py pre_tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "wsl --cd /home/oguz python3 /home/oguz/.gemini/config/plugins/edge/tools/brigade/orchestrator_guard.py post_tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "wsl --cd /home/oguz python3 /home/oguz/.gemini/config/plugins/edge/tools/brigade/orchestrator_guard.py pre_invocation",
        "timeout": 30
      }
    ]
  }
}
